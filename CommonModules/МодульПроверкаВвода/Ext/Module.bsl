Функция ПроверкаТелефона(Телефон) Экспорт
	
	КоличествоЦифр = 0;         
	

	Для Индекс = 1 По СтрДлина(Телефон) Цикл 
		
		Символ = Сред(Телефон, Индекс, 1);     
		
		Если Символ >= "0" И Символ <= "9" Тогда    
			
			КоличествоЦифр = КоличествоЦифр + 1;   
			
		ИначеЕсли СтрНайти("+-() ", Символ) = 0 Тогда   
			
			Возврат "В телефоне допустимы только цифры и символы + - ( )";      
			
		КонецЕсли;      
		
	КонецЦикла;


	Если КоличествоЦифр < 10 Или КоличествоЦифр > 12 Тогда 
		
		Возврат "В телефоне должно быть от 10 до 12 цифр";   
		
	КонецЕсли;
	

	Возврат "";
	
КонецФункции