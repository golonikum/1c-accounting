&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)

	Адрес = ПодготовитьДанныеНаСервере();
	ПолучитьФайл(Адрес, "orders.json", Истина);

КонецПроцедуры                          


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());

КонецПроцедуры


&НаСервере
Функция ПодготовитьДанныеНаСервере()

	ТекстJSON = СформироватьJSON();
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ТекстJSON, КодировкаТекста.UTF8, Ложь);
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции                   


&НаСервере
Функция СформироватьJSON()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтрокиЗаказа.Ссылка КАК Ссылка,
	|	СтрокиЗаказа.Ссылка.Номер КАК Номер,
	|	СтрокиЗаказа.Ссылка.Дата КАК Дата,
	|	ЕСТЬNULL(СтрокиЗаказа.Ссылка.Клиент.Наименование, """") КАК Клиент,
	|	ЕСТЬNULL(СтрокиЗаказа.Ссылка.Менеджер.Наименование, """") КАК Менеджер,
	|	СтрокиЗаказа.Ссылка.Статус КАК Статус,
	|	СтрокиЗаказа.Ссылка.СуммаДокумента КАК СуммаДокумента,
	|	ЕСТЬNULL(СтрокиЗаказа.Услуга.Артикул, """") КАК Артикул,
	|	ЕСТЬNULL(СтрокиЗаказа.Услуга.Наименование, """") КАК Услуга,
	|	СтрокиЗаказа.Количество КАК Количество,
	|	СтрокиЗаказа.Цена КАК Цена,
	|	СтрокиЗаказа.Сумма КАК Сумма
	|ИЗ
	|	Документ.ЗаказКлиента.Услуги КАК СтрокиЗаказа
	|ГДЕ
	|	СтрокиЗаказа.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|	И НЕ СтрокиЗаказа.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтрокиЗаказа.Ссылка.Дата,
	|	СтрокиЗаказа.НомерСтроки";

	Запрос.УстановитьПараметр("Начало", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("Конец", КонецДня(ДатаОкончания));

	Заказы = Новый Массив;
	ТекущийЗаказ = Неопределено;
	ТекущаяСсылка = Неопределено;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.Ссылка <> ТекущаяСсылка Тогда
			ТекущаяСсылка = Выборка.Ссылка;
			ТекущийЗаказ = Новый Структура;
			ТекущийЗаказ.Вставить("number", СокрЛП(Выборка.Номер));
			ТекущийЗаказ.Вставить("date", Формат(Выборка.Дата, "ДФ=yyyy-MM-dd'T'HH:mm:ss"));
			ТекущийЗаказ.Вставить("client", Выборка.Клиент);
			ТекущийЗаказ.Вставить("manager", Выборка.Менеджер);
			ТекущийЗаказ.Вставить("status", Строка(Выборка.Статус));
			ТекущийЗаказ.Вставить("total", Выборка.СуммаДокумента);
			ТекущийЗаказ.Вставить("items", Новый Массив);
			Заказы.Добавить(ТекущийЗаказ);
		КонецЕсли;

		Позиция = Новый Структура;
		Позиция.Вставить("sku", Выборка.Артикул);
		Позиция.Вставить("service", Выборка.Услуга);
		Позиция.Вставить("quantity", Выборка.Количество);
		Позиция.Вставить("price", Выборка.Цена);
		Позиция.Вставить("amount", Выборка.Сумма);
		ТекущийЗаказ.items.Добавить(Позиция);

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("exportedAt", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd'T'HH:mm:ss"));
	Результат.Вставить("orders", Заказы);

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Unix, Символ(9));
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Результат);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции