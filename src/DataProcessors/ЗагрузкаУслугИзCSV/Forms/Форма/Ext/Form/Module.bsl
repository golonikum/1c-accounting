
&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеВыбораФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Не Результат Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьНаСервере(Адрес);

КонецПроцедуры               


&НаСервере
Процедура ЗагрузитьНаСервере(Адрес)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	ИмяФайла = ПолучитьИмяВременногоФайла("csv");
	ДвоичныеДанные.Записать(ИмяФайла);

	Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);

	Создано = 0;
	Обновлено = 0;
	Ошибок = 0;

	Чтение.ПрочитатьСтроку(); // пропускаем заголовок
	НомерСтроки = 1;

	Пока Истина Цикл

		ТекстСтроки = Чтение.ПрочитатьСтроку();
		Если ТекстСтроки = Неопределено Тогда
			Прервать;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		Если ПустаяСтрока(ТекстСтроки) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Если ЗагрузитьСтроку(ТекстСтроки) Тогда
				Создано = Создано + 1;
			Иначе
				Обновлено = Обновлено + 1;
			КонецЕсли;
		Исключение
			Ошибок = Ошибок + 1;
			Сообщить("Строка " + НомерСтроки + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Чтение.Закрыть();
	УдалитьФайлы(ИмяФайла);

	Сообщить("Готово. Создано: " + Создано + ", обновлено: " + Обновлено + ", ошибок: " + Ошибок);

КонецПроцедуры        


&НаСервере
Функция ЗагрузитьСтроку(ТекстСтроки)

	Поля = СтрРазделить(ТекстСтроки, ";", Истина);
	Если Поля.Количество() < 5 Тогда
		ВызватьИсключение "Ожидается 5 полей, получено " + Поля.Количество();
	КонецЕсли;

	Артикул = СокрЛП(Поля[0]);
	Наименование = СокрЛП(Поля[1]);
	Единица = СокрЛП(Поля[2]);
	Цена = Число(СтрЗаменить(СокрЛП(Поля[3]), ",", "."));
	Длительность = Число(СтрЗаменить(СокрЛП(Поля[4]), ",", "."));

	Если Артикул = "" Или Наименование = "" Тогда
		ВызватьИсключение "Не заполнен артикул или наименование";
	КонецЕсли;

	Ссылка = Справочники.Услуги.НайтиПоРеквизиту("Артикул", Артикул);
	Если Ссылка.Пустая() Тогда
		ЭлементСправочника = Справочники.Услуги.СоздатьЭлемент();
		ЭлементСправочника.Артикул = Артикул;
		Новая = Истина;
	Иначе
		ЭлементСправочника = Ссылка.ПолучитьОбъект();
		Новая = Ложь;
	КонецЕсли;

	ЭлементСправочника.Наименование = Наименование;
	ЭлементСправочника.ЕдиницаИзмерения = Единица;
	ЭлементСправочника.Цена = Цена;
	ЭлементСправочника.Длительность = Длительность;
	ЭлементСправочника.Активна = Истина;
	ЭлементСправочника.Записать();

	Возврат Новая;

КонецФункции