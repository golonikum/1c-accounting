
&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры


&НаСервере
Процедура СформироватьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 5
	|	ПродажиОбороты.Клиент КАК Клиент,
	|	СУММА(ПродажиОбороты.СуммаОборот) КАК Сумма
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ПродажиОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Клиент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сумма УБЫВ";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода",
		?(ЗначениеЗаполнено(ДатаОкончания), КонецДня(ДатаОкончания), '00010101'));

	ТаблицаТопа.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры           

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());

КонецПроцедуры